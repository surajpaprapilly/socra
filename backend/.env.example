# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# (Optional) Model alias override
ANTHROPIC_MODEL=claude-sonnet-4-6

# Exa AI API Key (required for article search + cache seeding)
EXA_API_KEY=your_exa_api_key_here
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# Developer account email (set via Supabase Dashboard — see README for setup)
# This account must have app_metadata.role = "developer" in Supabase to bypass rate limits.
# DEV_ACCOUNT_EMAIL=dev@socra.internal