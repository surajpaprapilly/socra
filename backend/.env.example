# Copy this file to .env and fill in the values. See ../README.md for details.

# --- Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional model override. Leave unset to use the app default (claude-3-7-sonnet-20250219).
# ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# --- Exa (article search + cache seeding; needed for Learn mode) ---
EXA_API_KEY=your_exa_api_key_here

# --- Supabase ---
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional. Only the standalone maintenance scripts (query_db.py, fix_turn_db.py, ...)
# use a service-role key. Some scripts read it as SUPABASE_KEY instead.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Misc ---
# Deployed frontend origin, added to the CORS allow-list (required when RENDER is set).
# FRONTEND_URL=https://your-frontend.example.com
# Developer account email — bypasses the session rate limit. This account must also
# have app_metadata.role = "developer" set in the Supabase dashboard (see README).
# DEV_ACCOUNT_EMAIL=dev@socra.internal
